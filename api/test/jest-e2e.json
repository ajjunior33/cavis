{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "globalSetup": "<rootDir>/setup/global-setup.ts",
  "setupFiles": ["<rootDir>/setup/env.ts"],
  "maxWorkers": 1
}
